// StudentHub - MongoDB schema modeling via Prisma.
//
// This is a focused copy of the application's MongoDB modeling decisions.
// It demonstrates references, embedded JSON data, unique constraints and
// indexes without changing the application's existing schema.prisma file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  username    String   @unique
  email       String   @unique
  password    String
  role        Role?
  teachingTopics String[] @default([])

  coursesTaught    Course[]
  enrollments      Enrollment[]
  progress         Progress[]
  reviews          Review[]
  notifications    Notification[]
}

model Course {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  link        String
  category    String
  difficulty  Difficulty @default(BEGINNER)

  teacherId   String   @db.ObjectId
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]
  reviews     Review[]
  lessons     CourseLesson[]

  views       Int      @default(0)

  @@index([category])
  @@index([teacherId])
  @@index([difficulty])
}

model Enrollment {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  studentId String @db.ObjectId
  courseId  String @db.ObjectId

  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  bookmarked Boolean @default(false)

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Progress {
  id                   String @id @default(auto()) @map("_id") @db.ObjectId
  studentId            String @db.ObjectId
  courseId             String @db.ObjectId
  completionPercentage Int    @default(0)
  lessonsCompleted     Int    @default(0)

  // Small, bounded data that is always read with the Progress document.
  completedLessonIds String @default("[]")

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Review {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String?
  studentId String @db.ObjectId
  courseId  String @db.ObjectId

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
}

model CourseLesson {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  courseId String @db.ObjectId
  order    Int
  title    String
  videoUrl String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum Role {
  STUDENT
  TEACHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
